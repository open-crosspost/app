# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
API_DATABASE_URL=
BETTER_AUTH_SECRET=
API_DATABASE_AUTH_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CONNECT_PROJECT=
X_POLICY_MAX_PER_DAY=
OUTLAYER_APP_WALLET_KEY=

# app.auth
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
AUTH_DATABASE_URL=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.agent-connect
NEAR_INTENTS_AGENT_API_KEY=
AGENT_CONNECT_ENCRYPTION_KEY=

# plugins.connectors
OUTLAYER_APP_PAYMENT_KEY=

# Activity (activity.nearbuilders.org) — key stored server-side only, never committed
ACTIVITY_API_KEY=
ACTIVITY_SOURCE_ID=opencrosspost.com
