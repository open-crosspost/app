{
  "extends": "bos://dev.everything.near/everything.dev",
  "account": "work.efiz.near",
  "domain": "opencrosspost.com",
  "title": "Open Crosspost",
  "description": "Write once and share to X, Farcaster, and more social platforms from one place. Open Crosspost is coming soon.",
  "repository": "https://github.com/open-crosspost/app",
  "app": {
    "ui": {
      "name": "ui",
      "development": "local:ui"
    },
    "api": {
      "name": "api",
      "development": "local:api",
      "variables": {},
      "secrets": [
        "API_DATABASE_URL"
      ]
    }
  },
  "plugins": {
    "crosspost": {
      "development": "local:plugins/crosspost",
      "variables": {
        "baseUrl": "https://social.invalid",
        "timeout": "10000"
      },
      "secrets": [
        "nearAuthData"
      ]
    },
    "twitter": {
      "development": "local:plugins/twitter",
      "secrets": [
        "clientId",
        "clientSecret"
      ]
    },
    "farcaster": {
      "development": "local:plugins/farcaster",
      "variables": {
        "ipfsGatewayUrl": "https://gateway.pinata.cloud/ipfs",
        "timeout": "10000"
      },
      "secrets": [
        "farcasterDeveloperMnemonic",
        "neynarApiKey",
        "pinataJwt"
      ]
    }
  },
  "shared": {
    "ui": {
      "effect": {
        "version": "3.21.0",
        "requiredVersion": "^3.21.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "zod": {
        "version": "4.3.6",
        "requiredVersion": "^4.3.6",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@orpc/contract": {
        "version": "1.13.14",
        "requiredVersion": "^1.13.14",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-auth": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-near-auth": {
        "version": "1.5.0",
        "requiredVersion": "^1.5.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/api-key": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/passkey": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      }
    },
    "plugins": {}
  }
}
